/* Every construct of the face circuit language, version 1. */
circuit "All kinds \"quoted\" \\ name" {
    constant-combinator bare at (0, 0) {
        description = "line one\nline two"
        enabled = false
        item:iron-plate = 5
        fluid:water = -3
        item:"odd name"@"odd quality" = 0x10
        virtual:signal-A@rare = 2147483647
        space-location:nauvis = -2147483648
        custom:my.signal-1 = 0
    }

    constant-combinator grouped at (240, 0) tile (1.5, -2.5) facing east {
        section "Ore" {
            active = false
            multiplier = -0.5
            item:iron-ore = 1
            item:copper-ore = 2
        }
        section {
            asteroid-chunk:metallic-asteroid-chunk = 1; recipe:iron-gear-wheel = 2, entity:small-biter = 3
        }
        section "Empty" { }
    }

    arithmetic-combinator each_op at (0, 160) { each = each[red] * virtual:signal-A[green] }
    arithmetic-combinator shift tile (3, 4.5) { virtual:signal-B = 1 << item:iron-plate }
    arithmetic-combinator logic facing south at (480, 160) { quality:legendary = virtual:signal-A XOR -1 }
    arithmetic-combinator blank { }

    decider-combinator gate at (0, 320) {
        when each > 5 and virtual:signal-A[red] != virtual:signal-B[green] or anything <= -1 or everything = 0
        output each = input[red]
        output virtual:signal-C = 7
        output everything = input
        else output virtual:signal-D = input[green]
        else output anything = 1
    }

    selector-combinator pick at (0, 480) { operation = select  order = min  index = virtual:signal-I  index-comparator = >= }
    selector-combinator plain_selector {}
    selector-combinator counter { operation = count output = virtual:signal-C }
    selector-combinator rnd { operation = random interval = 60 }
    selector-combinator stack { operation = stack-size }
    selector-combinator rocket { operation = rocket-capacity }
    selector-combinator qf { operation = quality-filter quality = rare comparator = > }
    selector-combinator qs { operation = quality-select order = lowest }
    selector-combinator qt1 { operation = quality-transfer source = legendary destination = each }
    selector-combinator qt2 { operation = quality-transfer source = signal source-signal = item:iron-plate destination = virtual:signal-Q }
    selector-combinator clock { operation = time day-length = virtual:signal-L day-tick = virtual:signal-D game-tick = virtual:signal-T }

    small-lamp plain { }
    small-lamp light at (240, 480) {
        when anything > virtual:signal-A
        networks = green
        always-on = true
        colors = components
        red = virtual:signal-red
        green = virtual:signal-green
        blue = virtual:signal-blue
        rgb = virtual:signal-white
        color = #ff8000
    }

    small-electric-pole relay at (480, 480) { }
    big-electric-pole far tile (10, -4) { description = "2x2" }
    substation sub {
    }
    medium-electric-pole mid { } small-electric-pole near { }

    programmable-speaker quiet { }
    programmable-speaker alarm at (480, 320) tile (12.5, 0.5) {
        when virtual:signal-A > 0
        instrument = alarms
        note = siren
        volume = 62.5
        volume-signal = virtual:signal-V
        playback = global
        polyphony = true
        stop-playing-sounds = true
        show-alert = true
        show-on-map = false
        alert-icon = item:iron-plate
        alert-message = "Out of \"plates\"\nagain"
    }
    programmable-speaker tune { pitch = virtual:signal-P instrument = piano note = "F#3" playback = surface volume = 0 }
    programmable-speaker chime { when everything < virtual:signal-B instrument = "drum-kit" note = hat-1 playback = local }

    fast-inserter feeder at (720, 0) tile (16.5, 0.5) facing north {
        description = "Feeds the furnace"
        when item:iron-plate < 100
        logistic when anything > virtual:signal-L
        networks = red
        output-networks = none
        set-filters = true
        read-hand = hold
        set-stack-size = true
        stack-size-signal = virtual:signal-X
        blueprint-data = "{\"filters\":[{\"index\":1,\"name\":\"iron-plate\"}],\"use_filters\":true,\"quality\":\"rare\"}"
    }
    steel-chest box { read-contents = false read-empty-slots = true }
    "express-transport-belt" belt facing west { read-contents = entire-belt-hold }
    splitter side { input-left when item:coal > 0; output-right when everything <= 5 set-filter = true }
    train-stop stop tile (20, 4) { send-to-train = false, read-trains-count = true trains-count-signal = virtual:signal-C }
    radar dish { mode = universe channel = virtual:signal-1 }
    storage-tank tank facing south { read-contents = segment-contents }
    display-panel sign { blueprint-data = "{\"text\":\"Grüße \\\"quoted\\\" \\\\ 日本語\",\"control_behavior\":{\"parameters\":[]}}" }
    wooden-chest defaults { read-contents = true empty-slots-signal = virtual:signal-E }

    wire red bare.out <-> each_op.in
    wire green each_op.out <-> each_op.in
    wire red gate.in <-> each_op.out
    wire green gate.out <-> light.in
    wire red gate.out <-> relay
    wire red relay <-> far
    wire green far <-> sub
    wire green sub <-> mid; wire green near <-> mid
    wire red far <-> alarm.in
    wire green tune.in <-> relay
    wire red gate.out <-> feeder
    wire green feeder <-> box; wire red box <-> relay
    wire green dish <-> stop
}
