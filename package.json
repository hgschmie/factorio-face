{
  "name": "de.softwareforge.face",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FActorio Circuit Editor",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "catalog": "node tools/catalog/generate.mjs",
    "probe-wire-reach": "node tools/game-probe/wire-reach.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "codemirror": "6.0.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/autocomplete": "^6.0.0",
    "@lezer/highlight": "1.2.5",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "1.65.0",
    "electron": "44.9.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.9.1": true
  }
}
